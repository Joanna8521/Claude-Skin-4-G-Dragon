#!/usr/bin/env python3
"""photo2ansi: 把圖片轉成終端機色塊藝術。

零依賴：縮圖交給 macOS 內建的 sips，BMP 解碼用 stdlib 自己來。

    photo2ansi <圖片> [-w 寬度] [-o 輸出檔] [--mono]

用上半格字元 ▀：前景色畫上面那個像素、背景色畫下面那個，
所以一個字元格裝兩個像素列，比例才不會被終端機的 2:1 字元框拉長。

--mono 產出不帶顏色的灰階字元畫，給不吃 ANSI 的環境用。
"""

import argparse
import re
import shutil
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

# 由亮到暗，給 --mono 用
RAMP = "@%#*+=-:. "


def die(msg: str) -> None:
    print(f"錯誤：{msg}", file=sys.stderr)
    sys.exit(1)


def parse_crop(spec: str) -> tuple:
    """解析 WxH+X+Y，X/Y 是左上角在原圖的座標。"""
    m = re.fullmatch(r"(\d+)x(\d+)\+(\d+)\+(\d+)", spec.strip())
    if not m:
        die("裁切格式要寫成 WxH+X+Y，例如 400x400+120+40")
    return tuple(int(g) for g in m.groups())


def source_size(src: Path) -> tuple:
    r = subprocess.run(["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(src)],
                       capture_output=True, text=True)
    w = h = None
    for line in r.stdout.splitlines():
        if "pixelWidth:" in line:
            w = int(line.split(":")[1])
        elif "pixelHeight:" in line:
            h = int(line.split(":")[1])
    if not w or not h:
        die("讀不到圖片尺寸")
    return w, h


def to_bmp(src: Path, width: int, tmpdir: Path, crop: str = None) -> Path:
    """用 sips 裁切（可選）＋縮圖，轉成 BMP。高度依裁切後的比例算。"""
    if not shutil.which("sips"):
        die("找不到 sips，這支工具目前只支援 macOS")

    stage = src
    if crop:
        cw, ch, cx, cy = parse_crop(crop)
        sw, sh = source_size(src)
        if cx + cw > sw or cy + ch > sh:
            die(f"裁切範圍超出原圖（原圖 {sw}×{sh}）")
        # sips 是先置中裁切再套偏移，且參數順序是 Y X
        off_y = (cy + ch // 2) - sh // 2
        off_x = (cx + cw // 2) - sw // 2
        stage = tmpdir / "crop.png"
        r = subprocess.run(
            ["sips", "-s", "format", "png", "-c", str(ch), str(cw),
             "--cropOffset", str(off_y), str(off_x), str(src), "--out", str(stage)],
            capture_output=True, text=True,
        )
        if r.returncode != 0 or not stage.exists():
            die(f"sips 裁切失敗：{r.stderr.strip() or r.stdout.strip()}")

    dst = tmpdir / "frame.bmp"
    r = subprocess.run(
        ["sips", "-s", "format", "bmp", "--resampleWidth", str(width),
         str(stage), "--out", str(dst)],
        capture_output=True, text=True,
    )
    if r.returncode != 0 or not dst.exists():
        die(f"sips 轉檔失敗：{r.stderr.strip() or r.stdout.strip()}")
    return dst


def read_bmp(path: Path):
    """回傳 (w, h, pixels)，pixels[y][x] = (r, g, b)，y=0 是最上面那列。"""
    data = path.read_bytes()
    if data[:2] != b"BM":
        die("不是 BMP 檔，sips 的輸出不如預期")

    offset = struct.unpack_from("<I", data, 10)[0]
    dib_size = struct.unpack_from("<I", data, 14)[0]
    if dib_size < 40:
        die(f"不支援的 BMP 標頭大小 {dib_size}")

    w, h = struct.unpack_from("<ii", data, 18)
    bpp = struct.unpack_from("<H", data, 28)[0]
    compression = struct.unpack_from("<I", data, 30)[0]

    if bpp not in (24, 32):
        die(f"只支援 24/32 位元 BMP，這張是 {bpp} 位元")
    if compression not in (0, 3):
        die(f"不支援壓縮過的 BMP（compression={compression}）")

    # 高度為負代表由上而下存放
    top_down = h < 0
    h = abs(h)

    stride = ((w * bpp // 8) + 3) // 4 * 4   # 每列補齊到 4 的倍數
    step = bpp // 8

    rows = []
    for row in range(h):
        base = offset + row * stride
        px = []
        for col in range(w):
            i = base + col * step
            b, g, r = data[i], data[i + 1], data[i + 2]   # BMP 是 BGR
            px.append((r, g, b))
        rows.append(px)

    if not top_down:
        rows.reverse()   # 由下而上存放，翻回來
    return w, h, rows


def render_color(w: int, h: int, rows, indent: str) -> str:
    out = []
    for y in range(0, h - 1, 2):
        top, bottom = rows[y], rows[y + 1]
        line = [indent]
        prev = None
        for x in range(w):
            tr, tg, tb = top[x]
            br, bg, bb = bottom[x]
            cur = (tr, tg, tb, br, bg, bb)
            if cur != prev:
                line.append(f"\033[38;2;{tr};{tg};{tb}m\033[48;2;{br};{bg};{bb}m")
                prev = cur
            line.append("▀")
        line.append("\033[0m")
        out.append("".join(line))
    return "\n".join(out)


def render_mono(w: int, h: int, rows, indent: str) -> str:
    out = []
    # 一個字元對兩列，取平均亮度
    for y in range(0, h - 1, 2):
        line = [indent]
        for x in range(w):
            tr, tg, tb = rows[y][x]
            br, bg, bb = rows[y + 1][x]
            lum = (0.299 * (tr + br) + 0.587 * (tg + bg) + 0.114 * (tb + bb)) / 2
            line.append(RAMP[min(len(RAMP) - 1, int(lum / 256 * len(RAMP)))])
        out.append("".join(line).rstrip())
    return "\n".join(out)


def main() -> None:
    ap = argparse.ArgumentParser(add_help=True, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("image", type=Path)
    ap.add_argument("-w", "--width", type=int, default=44, help="輸出寬度（字元數），預設 44")
    ap.add_argument("-o", "--out", type=Path, help="輸出檔，省略就印到 stdout")
    ap.add_argument("--mono", action="store_true", help="不帶顏色的字元畫")
    ap.add_argument("--indent", default="  ", help="每行前面的縮排，預設兩格")
    ap.add_argument("-c", "--crop", metavar="WxH+X+Y",
                    help="先裁切再縮圖，X/Y 是左上角座標。全身照請裁到臉，否則五官會糊掉")
    args = ap.parse_args()

    if not args.image.exists():
        die(f"找不到圖片 {args.image}")
    if args.width < 4 or args.width > 200:
        die("寬度請給 4 到 200 之間")

    with tempfile.TemporaryDirectory() as td:
        bmp = to_bmp(args.image, args.width, Path(td), args.crop)
        w, h, rows = read_bmp(bmp)

    if h < 2:
        die("圖片太矮，轉不出東西")

    art = (render_mono if args.mono else render_color)(w, h, rows, args.indent)

    if args.out:
        args.out.parent.mkdir(parents=True, exist_ok=True)
        args.out.write_text(art + "\n", encoding="utf-8")
        mode = "灰階字元畫" if args.mono else "truecolor 色塊"
        print(f"✓ {args.image.name} → {args.out}（{w}×{h // 2} 字元，{mode}）")
    else:
        print(art)


if __name__ == "__main__":
    main()
