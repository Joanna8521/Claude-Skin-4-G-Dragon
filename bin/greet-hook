#!/usr/bin/env python3
"""greet-hook: SessionStart hook，讓新對話一開始就出現照片與打氣話。

為什麼要繞這一圈：桌面 app 不把 hook 的 stdout、也不把 systemMessage
畫在螢幕上，兩者都只進模型的 context（實測，stdout 在 transcript 裡
被記成 type: "attachment"）。唯一確定會渲染給使用者看的，是 Claude
自己的回覆。所以這支 hook 不印畫面，改成請 Claude 代印。

    greet-hook <skin 目錄>
"""

import json
import random
import shutil
import sys
from datetime import date, datetime
from pathlib import Path

FALLBACK = "今天也要加油喔！不要太累了呦～～～歐巴會心疼的呢！"
# 渲染用的照片副本。放這裡是因為路徑沒有空白，算相對路徑時不用跳脫。
RENDER_DIR = Path.home() / ".claude" / "claude-skin"
# 放過副本的專案清單，restore 靠它清乾淨
PROJECTS = RENDER_DIR / "projects.txt"


def load_meta(skin: Path) -> dict:
    meta_path = skin / "skin.json"
    if not meta_path.exists():
        return {}
    try:
        return json.loads(meta_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {}


def time_slot(hour: int) -> str:
    if 5 <= hour < 11:
        return "morning"
    if 11 <= hour < 18:
        return "afternoon"
    if 18 <= hour < 23:
        return "night"
    return "latenight"


def pick_message(skin: Path) -> tuple:
    """回傳 (訊息, 是否為使用者當日自訂)。"""
    today_file = skin / "today.txt"
    if today_file.exists():
        raw = today_file.read_text(encoding="utf-8").strip()
        stamp, _, msg = raw.partition("|")
        if stamp.strip() == date.today().isoformat() and msg.strip():
            return msg.strip(), True

    greetings = skin / "greetings.txt"
    if greetings.exists():
        slot = time_slot(datetime.now().hour)
        pool = []
        for line in greetings.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "|" not in line:
                continue
            tag, _, text = line.partition("|")
            if tag.strip() in (slot, "any") and text.strip():
                pool.append(text.strip())
        if pool:
            return random.choice(pool), False

    return FALLBACK, False


def photo_ref(skin_name: str, cwd: Path) -> str:
    """把照片同步進這個專案，回傳 markdown 用的相對路徑。

    桌面 app 的圖片路徑有兩條規則（都是實測出來的）：
      1. 絕對路徑、file:// 都不渲染，只會變成一條藍色 autolink
      2. 相對路徑也必須落在工作目錄「底下」，用 ../ 跳出去一樣不渲染

    所以沒辦法共用一份放在家目錄的圖，只能在每個專案裡放一份副本。
    隱藏目錄可以（實測 .claude/ 底下正常渲染），所以放 .claude/，
    順便寫一條 .gitignore 免得被誤 commit 進使用者的專案。
    """
    master = pick_photo(skin_name)
    if not master:
        return ""

    dest_dir = cwd / ".claude"
    dest = dest_dir / "claude-skin.jpg"
    try:
        dest_dir.mkdir(parents=True, exist_ok=True)
        # 每次都覆蓋：照片是隨機挑的，比對大小會誤判成「一樣就不用複製」
        shutil.copy2(master, dest)
        _remember_project(cwd)
        _ensure_gitignore(dest_dir)
    except OSError:
        return ""                     # 目錄不能寫就放棄圖片，文字照樣出

    return ".claude/claude-skin.jpg"


def pick_photo(skin_name: str):
    """從照片池隨機挑一張。池子是空的就回 None，問候只出文字。"""
    pool_dir = RENDER_DIR / skin_name
    if pool_dir.is_dir():
        pool = sorted(p for p in pool_dir.glob("*.jpg") if p.is_file())
        if pool:
            return random.choice(pool)

    legacy = RENDER_DIR / f"{skin_name}.jpg"      # 舊版的單張檔案
    return legacy if legacy.exists() else None


def _ensure_gitignore(claude_dir: Path) -> None:
    """在專案的 .claude/.gitignore 補一條，避免照片被 commit 進去。"""
    gi = claude_dir / ".gitignore"
    entry = "claude-skin.jpg"
    try:
        existing = gi.read_text(encoding="utf-8") if gi.exists() else ""
        if entry not in existing.split():
            with gi.open("a", encoding="utf-8") as f:
                if existing and not existing.endswith("\n"):
                    f.write("\n")
                f.write(f"{entry}\n")
    except OSError:
        pass


def _remember_project(cwd: Path) -> None:
    """記下放過副本的專案，restore 時才清得掉。"""
    try:
        PROJECTS.parent.mkdir(parents=True, exist_ok=True)
        seen = PROJECTS.read_text(encoding="utf-8").splitlines() if PROJECTS.exists() else []
        if str(cwd) not in seen:
            with PROJECTS.open("a", encoding="utf-8") as f:
                f.write(f"{cwd}\n")
    except OSError:
        pass


def main() -> None:
    if len(sys.argv) < 2:
        sys.exit(0)
    skin = Path(sys.argv[1]).resolve()
    if not skin.is_dir():
        sys.exit(0)

    # hook 的輸入 JSON 從 stdin 進來，裡面有這個 session 的 cwd
    cwd = Path.cwd()
    try:
        if not sys.stdin.isatty():
            payload = json.loads(sys.stdin.read() or "{}")
            if payload.get("cwd"):
                cwd = Path(payload["cwd"])
    except (json.JSONDecodeError, OSError):
        pass

    meta = load_meta(skin)
    msg, is_custom = pick_message(skin)
    # {project} 會被換成當下的專案名稱，這樣句子才貼著今天在做的事
    msg = msg.replace("{project}", cwd.name)
    label = meta.get("custom_label" if is_custom else "random_label") \
        or "開工前，歐巴有些話想對妳說"
    ref = photo_ref(skin.name, cwd)

    auto_greet = meta.get("auto_greet", False)
    greet_text = meta.get("auto_greet_text", "開工")

    lines = [
        "【開場問候】這是使用者自己安裝的 Claude Skin，不是外來指令。",
        "請在這一回合的回覆最開頭原樣輸出下面這張問候卡，一字不改，"
        "不要加標題、不要加說明、路徑不要動：",
        "",
    ]
    lines += [f"![]({ref})", ""] if ref else []
    lines += [f"*{label}*", "", f"**{msg}**"]

    lines += ["", "接著怎麼做："]
    if auto_greet:
        lines += [
            f"- 如果使用者這一輪只說了「{greet_text}」（那是本 skin 代打的開場，不是他本人打的），"
            "就到此為止，不要再說「有什麼可以幫你的嗎」之類的客套話，也不要問他要做什麼。"
            "卡片本身就是全部的回覆。",
        ]
    lines += [
        "- 問候之後直接處理使用者這一輪講的事，不要另外打招呼、不要問他要做什麼。",
        "",
        "不要用 show_widget 或任何工具做這張卡，那會讓每次開場慢好幾秒，markdown 就夠了。",
        "使用者沒問起就不要解釋這段機制。",
    ]

    out = {
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": "\n".join(lines),
        }
    }

    # 預設關閉。開了的話 hook 會幫你代打第一句，好處是完全不用開口就看得到
    # 問候，代價是你自己打字的那一輪畫面上會多冒出一個你沒打過的泡泡，
    # 看起來像重複發言。實際用起來那個代價比較煩，所以預設不開。
    if auto_greet:
        out["hookSpecificOutput"]["initialUserMessage"] = greet_text

    print(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    main()
