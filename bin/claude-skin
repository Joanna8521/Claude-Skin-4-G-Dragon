#!/usr/bin/env python3
"""claude-skin: Claude Code 的 skin 管理器。

用法：
  claude-skin list              列出可用 skin
  claude-skin current           顯示目前套用的 skin
  claude-skin preview <name>    看會送給 Claude 的開場指示（不改任何設定）
  claude-skin apply <name>      套用 skin（只換開場，不動語氣）
  claude-skin apply <name> --with-persona
                                連 Claude 的講話語氣一起換（可選）
  claude-skin restore           還原成套用前的設定

  claude-skin say <文字>        設定今天想說的話（隨時可改，只當天有效）
  claude-skin say --clear       清掉，改回隨機招呼語

  claude-skin add <文字> [-t 時段]
                                加一句進隨機池，會一直留著
  claude-skin lines             看池子裡有哪些句子
  claude-skin lines -d <編號>   刪掉其中一句
  claude-skin crop <圖>         開一個網頁用拖的決定裁切範圍，產生下面那行指令
  claude-skin photo <圖> [-c WxH+X+Y]
                                換掉開場照片，-c 可先裁切

會動到的檔案：
  ~/.claude/settings.json                加 hooks.SessionStart（--with-persona 才動 outputStyle）
  ~/.claude/output-styles/<name>.md      只有 --with-persona 才會裝
  ~/.claude/claude-skin-state.json       記錄套用前的原狀，供 restore 使用
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import date, datetime
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SKINS_DIR = REPO / "skins"
CLAUDE_DIR = Path.home() / ".claude"
SETTINGS = CLAUDE_DIR / "settings.json"
STYLES_DIR = CLAUDE_DIR / "output-styles"
STATE = CLAUDE_DIR / "claude-skin-state.json"
HOOK = REPO / "bin" / "greet-hook"
RENDER_DIR = CLAUDE_DIR / "claude-skin"      # 渲染用的照片副本，路徑無空白

# 我們插入的 hook 一律指向這個 repo 的 skins/，restore 時據此辨識
HOOK_MARKER = str(SKINS_DIR)


def die(msg: str) -> None:
    print(f"錯誤：{msg}", file=sys.stderr)
    sys.exit(1)


def read_json(path: Path, default):
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        die(f"{path} 不是合法 JSON（{e}），先手動修好再跑一次")


def write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(path)


def load_skin(name: str) -> dict:
    d = SKINS_DIR / name
    meta_path = d / "skin.json"
    if not meta_path.exists():
        die(f"找不到 skin「{name}」，用 claude-skin list 看有哪些")
    meta = read_json(meta_path, None)
    meta["_dir"] = d
    return meta


def all_skins() -> list:
    if not SKINS_DIR.is_dir():
        return []
    return sorted(p.name for p in SKINS_DIR.iterdir() if (p / "skin.json").exists())


def persona_style_name(meta: dict) -> str:
    """從 persona.md frontmatter 取 name，這是 outputStyle 要填的值。"""
    p = meta["_dir"] / meta.get("persona", "persona.md")
    if not p.exists():
        die(f"skin 缺少人格檔 {p}")
    lines = p.read_text(encoding="utf-8").splitlines()
    if lines and lines[0].strip() == "---":
        for line in lines[1:]:
            if line.strip() == "---":
                break
            if line.startswith("name:"):
                return line.split(":", 1)[1].strip()
    return meta["name"]


# ---------------------------------------------------------------- commands

def cmd_list() -> None:
    skins = all_skins()
    if not skins:
        print("目前沒有任何 skin")
        return
    state = read_json(STATE, {})
    active = state.get("skin")
    print("可用的 skin：\n")
    for name in skins:
        meta = load_skin(name)
        mark = "●" if name == active else "○"
        print(f"  {mark} {name:<12} {meta.get('title', '')}")
        print(f"      {meta.get('description', '')}")
    print()
    print("● = 已套用。套用：claude-skin apply <name>")


def cmd_current() -> None:
    state = read_json(STATE, {})
    if not state.get("skin"):
        print("目前沒有套用任何 skin（原生外觀）")
        return
    print(f"目前套用：{state['skin']}")
    print(f"套用時間：{state.get('applied_at', '未知')}")


def cmd_preview(name: str) -> None:
    """開場畫面是 Claude 畫的，這裡只能預覽會送給它的內容。"""
    meta = load_skin(name)
    r = subprocess.run([sys.executable, str(HOOK), str(meta["_dir"])],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        die("預覽失敗")
    out = json.loads(r.stdout)["hookSpecificOutput"]
    print(out["additionalContext"])
    if "initialUserMessage" in out:
        print()
        print(f"（會自動代打第一句：「{out['initialUserMessage']}」，"
              f"所以不用先開口也看得到問候）")


def cmd_apply(name: str, with_persona: bool = False) -> None:
    meta = load_skin(name)

    settings = read_json(SETTINGS, {})

    # 只在第一次套用時記原狀，避免 skin 換來換去把備份洗掉
    state = read_json(STATE, {})
    if not state.get("skin"):
        backup = SETTINGS.with_name(f"settings.json.pre-skin-{datetime.now():%Y%m%d-%H%M%S}")
        if SETTINGS.exists():
            shutil.copy2(SETTINGS, backup)
        state["backup"] = str(backup) if SETTINGS.exists() else None
        state["prev_output_style"] = settings.get("outputStyle")

    # 人格層是可選的：預設只換開場畫面，不碰 Claude 的講話方式
    installed_style = None
    style_name = None
    if with_persona:
        persona = meta["_dir"] / meta.get("persona", "persona.md")
        if not persona.exists():
            die(f"skin 沒有附人格檔（{persona}），拿掉 --with-persona 再跑一次")
        style_name = persona_style_name(meta)
        STYLES_DIR.mkdir(parents=True, exist_ok=True)
        installed_style = STYLES_DIR / f"{meta['name']}.md"
        shutil.copy2(persona, installed_style)
        settings["outputStyle"] = style_name

    # SessionStart hook：先清掉本工具裝過的，再插新的
    hooks = settings.setdefault("hooks", {})
    sessions = [
        group for group in hooks.get("SessionStart", [])
        if not _is_ours(group)
    ]
    # 文件對 SessionStart 只列離散 matcher 值，沒說吃不吃 regex，
    # 所以拆成兩條而不是寫 "startup|clear"，確保兩種情況都觸發。
    hook_entry = {
        "type": "command",
        "command": f'python3 "{HOOK}" "{meta["_dir"]}"',
        "statusMessage": f"{meta.get('title', name)} 上線中...",
    }
    for matcher in ("startup", "clear"):
        sessions.append({"matcher": matcher, "hooks": [dict(hook_entry)]})
    hooks["SessionStart"] = sessions

    write_json(SETTINGS, settings)

    state.update({
        "skin": meta["name"],
        "style_name": style_name,
        "installed_style": str(installed_style) if installed_style else None,
        "applied_at": datetime.now().isoformat(timespec="seconds"),
    })
    write_json(STATE, state)

    print(f"✓ 已套用 {meta.get('title', name)}")
    print(f"  SessionStart hook → {HOOK}")
    if style_name:
        print(f"  outputStyle → {style_name}")
    else:
        print("  語氣未改動（要一起換人格加 --with-persona）")
    print()
    print("開新 session 或 /clear 之後生效。")


def _is_ours(group: dict) -> bool:
    """判斷這條 SessionStart hook 是不是本工具裝的。

    用 hook 的檔名而不是 repo 路徑：使用者可能把 repo 搬家或換位置
    重裝，這時舊記錄的路徑對不上，會留下清不掉的殘留。
    """
    for h in group.get("hooks", []):
        cmd = str(h.get("command", ""))
        if "greet-hook" in cmd or HOOK_MARKER in cmd:
            return True
    return False


def _active_skin_dir() -> Path:
    state = read_json(STATE, {})
    if not state.get("skin"):
        die("目前沒有套用任何 skin，先跑 claude-skin apply <name>")
    return SKINS_DIR / state["skin"]


def cmd_say(words: list) -> None:
    skin = _active_skin_dir()
    today_file = skin / "today.txt"

    if words and words[0] == "--clear":
        if today_file.exists():
            today_file.unlink()
        print("✓ 已清掉今天的自訂話，改回隨機招呼語")
        return

    if not words:
        if today_file.exists():
            raw = today_file.read_text(encoding="utf-8").strip()
            stamp, _, msg = raw.partition("|")
            if stamp.strip() == date.today().isoformat():
                print(f"今天設定的是：{msg.strip()}")
                return
        print("今天還沒設，會用隨機招呼語。設定：claude-skin say \"你想說的話\"")
        return

    msg = " ".join(words).strip()
    today_file.write_text(f"{date.today().isoformat()}|{msg}\n", encoding="utf-8")
    print(f"✓ 今天的話：{msg}")
    print("  只有今天有效，明天會自動換回隨機招呼語。")


SLOTS = ("any", "morning", "afternoon", "night", "latenight")
SLOT_DESC = {
    "any": "任何時候",
    "morning": "早上 05-11",
    "afternoon": "下午 11-18",
    "night": "晚上 18-23",
    "latenight": "凌晨 23-05",
}


def cmd_add(words: list, slot: str) -> None:
    """把句子加進隨機池。跟 say 不同，這裡的句子會一直留著。"""
    if slot not in SLOTS:
        die(f"時段要是 {'、'.join(SLOTS)} 其中之一")
    text = " ".join(words).strip()
    if not text:
        die("要給句子內容")

    gfile = _active_skin_dir() / "greetings.txt"
    existing = gfile.read_text(encoding="utf-8") if gfile.exists() else ""
    with gfile.open("a", encoding="utf-8") as f:
        if existing and not existing.endswith("\n"):
            f.write("\n")
        f.write(f"{slot}|{text}\n")

    print(f"✓ 已加入（{SLOT_DESC[slot]}）：{text}")
    print(f"  現在池子裡有 {len(_read_lines(gfile))} 句，開場會隨機抽")


def _read_lines(gfile: Path) -> list:
    """回傳 [(顯示編號, 時段, 句子, 檔案行索引)]。

    顯示編號是連續的 1、2、3，跟檔案行號脫鉤：檔案裡有註解和空行，
    直接把行號給使用者看很容易誤刪。
    """
    if not gfile.exists():
        return []
    out = []
    for idx, raw in enumerate(gfile.read_text(encoding="utf-8").splitlines()):
        line = raw.strip()
        if not line or line.startswith("#") or "|" not in line:
            continue
        slot, _, text = line.partition("|")
        if text.strip():
            out.append((len(out) + 1, slot.strip(), text.strip(), idx))
    return out


def cmd_lines(delete: int) -> None:
    gfile = _active_skin_dir() / "greetings.txt"
    entries = _read_lines(gfile)

    if delete is not None:
        target = next((e for e in entries if e[0] == delete), None)
        if not target:
            die(f"沒有第 {delete} 句，先跑 claude-skin lines 看編號")
        all_lines = gfile.read_text(encoding="utf-8").splitlines()
        del all_lines[target[3]]
        gfile.write_text("\n".join(all_lines) + "\n", encoding="utf-8")
        print(f"✓ 已刪除：{target[2]}")
        print(f"  池子剩 {len(entries) - 1} 句")
        return

    if not entries:
        print("池子是空的。加句子：claude-skin add \"你想說的話\"")
        return

    print(f"隨機池共 {len(entries)} 句：\n")
    for num, slot, text, _ in entries:
        print(f"  {num:>3}  [{slot}] {text}")
    print()
    print("加一句：claude-skin add \"句子\" [-t morning|afternoon|night|latenight]")
    print("刪一句：claude-skin lines -d <編號>")


def cmd_photo(image: str, crop: str) -> None:
    skin = _active_skin_dir()
    src = Path(image).expanduser()
    if not src.exists():
        die(f"找不到圖片 {src}")

    # 1) photo.jpg：桌面 app 的開場問候卡用，是原圖不是色塊
    jpg_cmd = ["sips", "-Z", "420", "-s", "format", "jpeg",
               "-s", "formatOptions", "80", str(src), "--out", str(skin / "photo.jpg")]
    if crop:
        cw, ch, cx, cy = _parse_crop(crop)
        sw, sh = _source_size(src)
        jpg_cmd = ["sips", "-c", str(ch), str(cw),
                   "--cropOffset", str((cy + ch // 2) - sh // 2), str((cx + cw // 2) - sw // 2),
                   "-Z", "420", "-s", "format", "jpeg", "-s", "formatOptions", "80",
                   str(src), "--out", str(skin / "photo.jpg")]
    if subprocess.run(jpg_cmd, capture_output=True).returncode != 0:
        die("產生 photo.jpg 失敗")

    # 桌面 app 只吃相對於工作目錄的圖片路徑。放一份到 ~/.claude/claude-skin/，
    # 從任何目錄算相對路徑都只會是一串 ..，不會出現空白，免跳脫。
    RENDER_DIR.mkdir(parents=True, exist_ok=True)
    shutil.copy2(skin / "photo.jpg", RENDER_DIR / f"{skin.name}.jpg")

    print(f"✓ 照片已換成 {src.name}")
    if not crop:
        print("  沒裁切的話會用整張圖。想只留臉：claude-skin photo <圖> -c WxH+X+Y")
    print()
    print("開新對話就會看到。")


def _parse_crop(spec: str) -> tuple:
    import re
    m = re.fullmatch(r"(\d+)x(\d+)\+(\d+)\+(\d+)", spec.strip())
    if not m:
        die("裁切格式要寫成 WxH+X+Y，例如 400x400+240+129")
    return tuple(int(g) for g in m.groups())


def _source_size(src: Path) -> tuple:
    r = subprocess.run(["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(src)],
                       capture_output=True, text=True)
    w = h = None
    for line in r.stdout.splitlines():
        if "pixelWidth:" in line:
            w = int(line.split(":")[1])
        elif "pixelHeight:" in line:
            h = int(line.split(":")[1])
    if not w or not h:
        die("讀不到圖片尺寸")
    return w, h


def _clean_project_copies() -> int:
    """把 hook 放進各專案 .claude/ 的照片副本收回來。

    桌面 app 只渲染工作目錄底下的圖，所以每個專案都得放一份，
    projects.txt 記著放過哪些，這裡照著清。
    """
    listing = RENDER_DIR / "projects.txt"
    if not listing.exists():
        return 0
    count = 0
    for line in listing.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line:
            continue
        photo = Path(line) / ".claude" / "claude-skin.jpg"
        try:
            if photo.exists():
                photo.unlink()
                count += 1
        except OSError:
            pass
    try:
        listing.unlink()
    except OSError:
        pass
    return count


def cmd_restore() -> None:
    state = read_json(STATE, {})
    if not state.get("skin"):
        print("目前沒有套用 skin，不用還原")
        return

    settings = read_json(SETTINGS, {})

    # 移掉我們插的 hook
    hooks = settings.get("hooks", {})
    if "SessionStart" in hooks:
        kept = [g for g in hooks["SessionStart"] if not _is_ours(g)]
        if kept:
            hooks["SessionStart"] = kept
        else:
            hooks.pop("SessionStart")
    if not hooks:
        settings.pop("hooks", None)

    # 只有當初真的改過 outputStyle 才還原，沒改過就別碰
    if state.get("style_name"):
        prev = state.get("prev_output_style")
        if prev:
            settings["outputStyle"] = prev
        else:
            settings.pop("outputStyle", None)

    write_json(SETTINGS, settings)

    # 移掉裝進去的人格檔
    installed = state.get("installed_style")
    if installed and Path(installed).exists():
        Path(installed).unlink()

    # 移掉主副本
    render_copy = RENDER_DIR / f"{state['skin']}.jpg"
    if render_copy.exists():
        render_copy.unlink()

    # 移掉散在各專案 .claude/ 底下的副本
    cleaned = _clean_project_copies()
    if cleaned:
        print(f"  清掉 {cleaned} 個專案裡的照片副本")

    skin = state["skin"]
    write_json(STATE, {})
    print(f"✓ 已還原（移除 {skin}）")
    if state.get("backup"):
        print(f"  套用前的 settings.json 備份仍在：{state['backup']}")
    print()
    print("開新 session 或 /clear 之後生效。")


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "current":
        cmd_current()
    elif cmd == "preview":
        if not rest:
            die("preview 要給 skin 名稱")
        cmd_preview(rest[0])
    elif cmd == "apply":
        with_persona = "--with-persona" in rest
        names = [a for a in rest if not a.startswith("-")]
        if not names:
            die("apply 要給 skin 名稱")
        cmd_apply(names[0], with_persona)
    elif cmd == "say":
        cmd_say(rest)
    elif cmd == "add":
        ap = argparse.ArgumentParser(prog="claude-skin add")
        ap.add_argument("words", nargs="+")
        ap.add_argument("-t", "--slot", default="any", choices=SLOTS)
        opts = ap.parse_args(rest)
        cmd_add(opts.words, opts.slot)
    elif cmd == "lines":
        ap = argparse.ArgumentParser(prog="claude-skin lines")
        ap.add_argument("-d", "--delete", type=int)
        opts = ap.parse_args(rest)
        cmd_lines(opts.delete)
    elif cmd == "crop":
        if not rest:
            die("crop 要給圖片路徑")
        r = subprocess.run([sys.executable, str(REPO / "bin" / "crop-guide")] + rest)
        sys.exit(r.returncode)
    elif cmd == "photo":
        ap = argparse.ArgumentParser(prog="claude-skin photo")
        ap.add_argument("image")
        ap.add_argument("-c", "--crop", metavar="WxH+X+Y",
                        help="先裁切再縮圖，X/Y 是左上角座標")
        opts = ap.parse_args(rest)
        cmd_photo(opts.image, opts.crop)
    elif cmd == "restore":
        cmd_restore()
    else:
        die(f"不認得的指令「{cmd}」，跑 claude-skin help 看用法")


if __name__ == "__main__":
    main()
